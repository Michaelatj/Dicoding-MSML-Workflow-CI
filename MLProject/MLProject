name: social_media_mental_health

conda_env: conda.yaml

entry_points:
  main:
    parameters:
      train_path:
        type: str
        default: "social_media_mental_health_preprocessing/train.csv"
      test_path:
        type: str
        default: "social_media_mental_health_preprocessing/test.csv"
      n_estimators:
        type: int
        default: 100
      max_depth:
        type: str
        default: "None"
      min_samples_split:
        type: int
        default: 2
      min_samples_leaf:
        type: int
        default: 1
    command: "python modelling.py --train_path {train_path} --test_path {test_path} --n_estimators {n_estimators} --max_depth {max_depth} --min_samples_split {min_samples_split} --min_samples_leaf {min_samples_leaf}"
